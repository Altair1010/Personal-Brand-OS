{
  "name": "personal-brand-os",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "prisma db seed",
    "app": "electron electron/main.js",
    "build:desktop": "next build",
    "app:prod": "electron electron/main.js --prod",
    "test": "vitest run",
    "icons": "node scripts/make-icons.js",
    "predist": "next build && node scripts/prepare-package.js",
    "dist": "electron-builder --config electron-builder.yml",
    "dist:win": "electron-builder --win --config electron-builder.yml",
    "dist:mac": "electron-builder --mac --config electron-builder.yml"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "next": "15.3.4",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.3.4",
    "postcss": "^8.5.1",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
