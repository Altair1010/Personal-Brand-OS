// Personal Brand Strategy OS — Prisma schema (SQLite) — MVP LOCKED

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserIdentity {
  id        String   @id
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authIdentities AuthIdentity[]
  profile        UserProfile?
  memberships    Membership[]

  workspaceGrantsCreated WorkerWorkspaceGrant[] @relation("WorkspaceGrantCreatedBy")
  workspaceGrantsRevoked WorkerWorkspaceGrant[] @relation("WorkspaceGrantRevokedBy")
  brandGrantsCreated     WorkerBrandGrant[]     @relation("BrandGrantCreatedBy")
  brandGrantsRevoked     WorkerBrandGrant[]     @relation("BrandGrantRevokedBy")
  approvalsRequested     ApprovalRequest[]      @relation("ApprovalRequestedBy")
  approvalsDecided       ApprovalRequest[]      @relation("ApprovalDecidedBy")
  approvalsConsumed      ApprovalRequest[]      @relation("ApprovalConsumedBy")
}

model AuthIdentity {
  id             String       @id
  userIdentityId String
  provider       String
  subject        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userIdentity   UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@index([userIdentityId])
}

model Organization {
  id         String    @id
  name       String
  status     String    @default("ACTIVE")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships        Membership[]
  workspaces         Workspace[]
  brands             Brand[]
  brandDna           BrandDNA[]
  goals              Goal[]
  segments           AudienceSegment[]
  pillars            ContentPillar[]
  templates          ContentTemplate[]
  frameworks         Framework[]
  strategies         Strategy[]
  ideas              ContentIdea[]
  drafts             ContentDraft[]
  posts              Post[]
  facebookAccounts   FacebookAccount[]
  insights           PerformanceInsight[]
  promptRuns         PromptRun[]
  exports            ExportHistory[]
  metricObservations MetricObservation[]
  agentRuns          AgentRun[]
  jobs               Job[]
  approvals          ApprovalRequest[]
  workspaceGrants    WorkerWorkspaceGrant[]
  brandGrants        WorkerBrandGrant[]
  auditEntries       AuditEntry[]
}

model Membership {
  id               String       @id
  userIdentityId   String
  organizationId   String
  organizationRole String?
  status           String       @default("ACTIVE")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  userIdentity     UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workspaceRoleBindings WorkspaceRoleBinding[]
  brandRoleBindings     BrandRoleBinding[]

  @@unique([userIdentityId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model Workspace {
  id             String       @id
  organizationId String
  name           String
  status         String       @default("ACTIVE")
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  brands            Brand[]
  roleBindings      WorkspaceRoleBinding[]
  agentRuns         AgentRun[]
  jobs              Job[]
  workerGrants      WorkerWorkspaceGrant[]
  brandWorkerGrants WorkerBrandGrant[]
  approvals         ApprovalRequest[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model WorkspaceRoleBinding {
  id             String     @id
  membershipId   String
  organizationId String
  workspaceId    String
  role           String
  status         String     @default("ACTIVE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workspace      Workspace  @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([membershipId, workspaceId])
  @@index([organizationId, workspaceId, status])
}

model Brand {
  id             String       @id
  organizationId String
  workspaceId    String
  name           String
  status         String       @default("ACTIVE")
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace      Workspace    @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  roleBindings       BrandRoleBinding[]
  brandDna           BrandDNA[]
  goals              Goal[]
  segments           AudienceSegment[]
  pillars            ContentPillar[]
  templates          ContentTemplate[]
  frameworks         Framework[]
  strategies         Strategy[]
  ideas              ContentIdea[]
  drafts             ContentDraft[]
  posts              Post[]
  facebookAccounts   FacebookAccount[]
  insights           PerformanceInsight[]
  promptRuns         PromptRun[]
  exports            ExportHistory[]
  metricObservations MetricObservation[]
  agentRuns          AgentRun[]
  jobs               Job[]
  workerGrants       WorkerBrandGrant[]
  approvals          ApprovalRequest[]

  @@unique([id, organizationId])
  @@unique([id, workspaceId, organizationId])
  @@index([organizationId, workspaceId, status])
}

model BrandRoleBinding {
  id             String     @id
  membershipId   String
  organizationId String
  workspaceId    String
  brandId        String
  role           String
  status         String     @default("ACTIVE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand          Brand      @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)

  @@unique([membershipId, brandId])
  @@index([organizationId, workspaceId, brandId, status])
}

model MetricObservation {
  id             String       @id
  organizationId String
  brandId        String
  legacyPostId   String?
  metricKey      String
  valueKind      String
  numericValue   Float?
  textValue      String?
  observedAt     DateTime
  source         String
  sourceRecordId String
  dedupeKey      String
  provenance     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  brand          Brand        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  legacyPost     Post?        @relation(fields: [legacyPostId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([brandId, dedupeKey])
  @@index([organizationId, brandId, metricKey, observedAt])
  @@index([legacyPostId])
}

model AppState {
  id                 String    @id @default("singleton")
  activeGoalId       String?
  activeStrategyId   String?
  audienceApprovedAt DateTime?
  supabaseUserId     String?
  lastCloudSyncAt    DateTime?
  updatedAt          DateTime  @updatedAt
}

model UserProfile {
  id             String        @id @default(cuid())
  userIdentityId String?       @unique
  name           String
  headline       String?
  bio            String?
  avatarUrl      String?
  locale         String        @default("vi")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  identity       UserIdentity? @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)

  brandDna   BrandDNA?
  goals      Goal[]
  segments   AudienceSegment[]
  pillars    ContentPillar[]
  templates  ContentTemplate[]
  frameworks Framework[]
  strategies Strategy[]
  ideas      ContentIdea[]
  drafts     ContentDraft[]
  posts      Post[]
  insights   PerformanceInsight[]
  exports    ExportHistory[]
}

// BrandDNA đã GỘP CompanyProfile (companyName/offers/usp/region)
model BrandDNA {
  id                       String        @id @default(cuid())
  userId                   String        @unique
  organizationId           String?
  brandId                  String?       @unique
  // --- lõi cá nhân ---
  whoAmI                   String?
  field                    String?
  threeWords               Json?
  coreBeliefs              String?
  differentiation          String?
  personalStory            String?
  expertise                String?
  customerProfile          String?
  customerPain             String?
  customerMisunderstanding String?
  marketEducationGoal      String?
  // --- bối cảnh doanh nghiệp (gộp từ CompanyProfile) ---
  companyName              String?
  offers                   Json?
  usp                      String?
  region                   String?
  // --- meta ---
  sourceFiles              Json?
  aiPositioning            String?
  aiSuggestions            Json?
  version                  Int           @default(1)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  user                     UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization             Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand                    Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, brandId])
}

model Goal {
  id                String        @id @default(cuid())
  userId            String
  organizationId    String?
  brandId           String?
  name              String
  goalType          String
  timeRangeStart    DateTime?
  timeRangeEnd      DateTime?
  targetAudience    String?
  mainOffer         String?
  mainMessage       String?
  kpi               Json?
  contentRatio      Json?
  risk              String?
  successDefinition String?
  status            String        @default("active")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand             Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)

  strategies Strategy[]
  segments   AudienceSegment[]
  pillars    ContentPillar[]

  @@index([userId, status])
  @@index([organizationId, brandId])
}

// pain/falseBelief/... gộp thẳng vào persona (bỏ bảng PainPoint)
model AudienceSegment {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  brandId        String?
  goalId         String?
  name           String
  pain           String?
  falseBelief    String?
  fear           String?
  desire         String?
  language       String?
  contentAngle   String?
  cta            String?
  offer          String?
  source         String        @default("ai")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId, brandId])
}

model ContentPillar {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  brandId        String?
  goalId         String?
  name           String
  description    String?
  ratioPercent   Int           @default(0)
  objectiveMix   Json?
  status         String        @default("active")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)

  dailyPlans DailyPlan[]
  ideas      ContentIdea[]
  drafts     ContentDraft[]

  @@index([userId])
  @@index([organizationId, brandId])
}

model ContentObjective {
  id          String            @id @default(cuid())
  key         String            @unique // seo|educate|trust|conversion|story|community
  label       String
  description String?
  color       String?
  templates   ContentTemplate[]
}

// Seed cứng ở MVP (không có editor CRUD — read-only)
model ContentTemplate {
  id             String           @id @default(cuid())
  userId         String?
  organizationId String?
  brandId        String?
  name           String
  objectiveKey   String
  structure      Json
  description    String?
  exampleOutput  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           UserProfile?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?           @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  objective      ContentObjective @relation(fields: [objectiveKey], references: [key])

  @@index([objectiveKey])
  @@index([organizationId, brandId])
}

// Seed cứng ở MVP (read-only)
model Framework {
  id             String        @id @default(cuid())
  userId         String?
  organizationId String?
  brandId        String?
  name           String
  slug           String        @unique
  summary        String?
  steps          Json?
  whenToUse      String?
  example        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           UserProfile?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  strategies     Strategy[]

  @@index([organizationId, brandId])
}

model Strategy {
  id             String            @id @default(cuid())
  userId         String
  organizationId String?
  brandId        String?
  goalId         String
  name           String
  timeframeDays  Int               @default(30) // MVP: chỉ 30
  frameworkSlug  String?
  status         String            @default("active")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?            @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goal           Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  framework      Framework?        @relation(fields: [frameworkSlug], references: [slug], onDelete: SetNull)
  versions       StrategyVersion[]

  @@index([userId, goalId])
  @@index([organizationId, brandId])
}

model StrategyVersion {
  id                   String       @id @default(cuid())
  strategyId           String
  version              Int
  reason               String // BẮT BUỘC: lý do đổi hướng
  assumptions          Json?
  contentRatio         Json?
  weeklyThemes         Json?
  dailyPlanOutline     Json?
  ctaPlan              Json?
  topicMap             Json?
  recommendedTemplates Json?
  kpiToTrack           Json?
  doNotList            Json?
  aiPromptRunId        String?
  editedAt             DateTime? // EM2c: đánh dấu version bị chỉnh sửa tay
  createdAt            DateTime     @default(now())
  strategy             Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  promptRun            PromptRun?   @relation(fields: [aiPromptRunId], references: [id], onDelete: SetNull)
  weeklyPlans          WeeklyPlan[]
  posts                Post[]

  @@unique([strategyId, version])
  @@index([strategyId, version])
}

// campaignId đã BỎ — WeeklyPlan link thẳng StrategyVersion
model WeeklyPlan {
  id                String          @id @default(cuid())
  strategyVersionId String
  weekIndex         Int
  theme             String?
  focusPillarId     String?
  objectivesMix     Json?
  notes             String?
  createdAt         DateTime        @default(now())
  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  dailyPlans        DailyPlan[]

  @@index([strategyVersionId])
}

model DailyPlan {
  id               String         @id @default(cuid())
  weeklyPlanId     String
  date             DateTime?
  dayIndex         Int
  plannedObjective String?
  plannedPillarId  String?
  suggestedTopic   String?
  suggestedCta     String?
  status           String         @default("planned")
  createdAt        DateTime       @default(now())
  weeklyPlan       WeeklyPlan     @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  plannedPillar    ContentPillar? @relation(fields: [plannedPillarId], references: [id], onDelete: SetNull)
  ideas            ContentIdea[]
  posts            Post[]

  @@index([weeklyPlanId])
}

model ContentIdea {
  id             String         @id @default(cuid())
  dailyPlanId    String?
  userId         String
  organizationId String?
  brandId        String?
  title          String
  objectiveKey   String?
  pillarId       String?
  angle          String?
  hookSeed       String?
  notes          String?
  source         String         @default("ai")
  status         String         @default("idea")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  dailyPlan      DailyPlan?     @relation(fields: [dailyPlanId], references: [id], onDelete: SetNull)
  user           UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?         @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pillar         ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  drafts         ContentDraft[]

  @@index([userId, status])
  @@index([organizationId, brandId])
}

// contentJson (TipTap) đã BỎ. Thêm analytic fields để Performance group-by được.
model ContentDraft {
  id              String         @id @default(cuid())
  contentIdeaId   String?
  userId          String
  organizationId  String?
  brandId         String?
  version         Int            @default(1)
  objectiveKey    String?
  pillarId        String?
  framework       String?
  tone            String?
  length          String?
  // --- analytic dimensions (bắt buộc cho Performance/Revision) ---
  hookStyle       String? // question|contrarian|story|curiosity|pain
  ctaIntensity    String? // soft|medium|hard
  format          String? // text|image|carousel|video|reel
  topic           String?
  // --- nội dung (plain text FB) ---
  hook            String?
  body            String?
  ending          String?
  hashtags        Json?
  imageSuggestion String?
  contentMarkdown String?
  aiPromptRunId   String?
  status          String         @default("draft")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  contentIdea     ContentIdea?   @relation(fields: [contentIdeaId], references: [id], onDelete: SetNull)
  user            UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand           Brand?         @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pillar          ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  promptRun       PromptRun?     @relation(fields: [aiPromptRunId], references: [id], onDelete: SetNull)
  post            Post?

  @@index([organizationId, brandId])
}

// Mirror analytic dims + attribution (strategyVersionId, dailyPlanId)
model Post {
  id                 String              @id @default(cuid())
  contentDraftId     String              @unique
  userId             String
  organizationId     String?
  brandId            String?
  strategyVersionId  String?
  dailyPlanId        String?
  facebookAccountId  String?
  publishedAt        DateTime?
  platform           String              @default("facebook")
  permalink          String?
  finalText          String?
  // mirror để group-by nhanh (không cần join qua draft)
  objectiveKey       String?
  pillarId           String?
  hookStyle          String?
  ctaIntensity       String?
  format             String?
  topic              String?
  status             String              @default("posted")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  contentDraft       ContentDraft        @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  user               UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand              Brand?              @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  strategyVersion    StrategyVersion?    @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  dailyPlan          DailyPlan?          @relation(fields: [dailyPlanId], references: [id], onDelete: SetNull)
  facebookAccount    FacebookAccount?    @relation(fields: [facebookAccountId], references: [id])
  metrics            MetricSnapshot[]
  metricObservations MetricObservation[]

  @@index([userId])
  @@index([strategyVersionId])
  @@index([facebookAccountId])
  @@index([organizationId, brandId])
}

// EM1c: linked Facebook Page(s). accessToken stored ENCRYPTED via lib/ai/keystore
// (connect action encrypts; schema stores the ciphertext string, never plaintext).
model FacebookAccount {
  id             String        @id @default(cuid())
  ownerRef       String        @default("local")
  organizationId String?
  brandId        String?
  pageId         String
  pageName       String
  accessToken    String
  tokenExpiresAt DateTime?
  linkedAt       DateTime      @default(now())
  posts          Post[]
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([ownerRef, pageId])
  @@unique([brandId, pageId])
  @@index([organizationId, brandId])
}

// MVP: 1 bản/Post (@@unique). daysSincePost để chuẩn hóa so sánh. Bỏ sentiment.
model MetricSnapshot {
  id             String    @id @default(cuid())
  postId         String    @unique
  capturedAt     DateTime  @default(now())
  daysSincePost  Int?
  reach          Int?
  engagement     Int?
  comments       Int?
  shares         Int?
  saves          Int?
  inboxNote      String?
  conversionNote String?
  source         String    @default("manual")
  postUrl        String?
  fbRawResponse  Json?
  fetchedAt      DateTime?
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PerformanceInsight {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  brandId        String?
  scope          String // post|pillar|hook|cta|format|weekly
  refId          String?
  period         String?
  finding        String
  evidence       Json?
  recommendation String?
  confidence     String        @default("normal") // low|normal
  aiPromptRunId  String?
  createdAt      DateTime      @default(now())
  user           UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  promptRun      PromptRun?    @relation(fields: [aiPromptRunId], references: [id], onDelete: SetNull)

  @@index([userId, scope])
  @@index([organizationId, brandId])
}

model PromptTemplate {
  id                String      @id @default(cuid())
  moduleKey         String
  name              String
  version           Int         @default(1)
  systemInstruction String
  userTemplate      String
  inputSchema       Json?
  outputSchema      Json?
  validationNotes   String?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  runs              PromptRun[]

  @@unique([moduleKey, version])
}

model PromptRun {
  id               String          @id @default(cuid())
  promptTemplateId String?
  organizationId   String?
  brandId          String?
  moduleKey        String
  provider         String
  model            String
  input            Json?
  rawOutput        String?
  parsedOutput     Json?
  status           String          @default("ok") // ok|invalid_json|error
  latencyMs        Int?
  tokensIn         Int?
  tokensOut        Int?
  error            String?
  createdAt        DateTime        @default(now())
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand            Brand?          @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)

  strategyVersions StrategyVersion[]
  drafts           ContentDraft[]
  insights         PerformanceInsight[]

  @@index([moduleKey, status, createdAt])
  @@index([organizationId, brandId, createdAt])
}

model AIModelConfig {
  id          String   @id @default(cuid())
  provider    String
  model       String
  label       String?
  temperature Float?
  maxTokens   Int?
  apiKey      String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ExportHistory {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  brandId        String?
  kind           String // markdown|csv|backup
  scope          String?
  filename       String
  createdAt      DateTime      @default(now())
  user           UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([userId])
  @@index([organizationId, brandId])
}

model AgentRun {
  id                    String    @id
  organizationId        String
  workspaceId           String?
  brandId               String?
  schemaVersion         String    @default("1.0")
  status                String    @default("QUEUED")
  roleRef               String
  task                  Json
  contextRef            Json
  permissionManifestRef String
  requiredCapabilities  Json
  idempotencyKey        String?
  requestFingerprint    String
  correlationId         String
  terminalResult        Json?
  terminalFingerprint   String?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace?        @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand        Brand?            @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)
  jobs         Job[]
  events       RunEvent[]
  approvals    ApprovalRequest[]

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, workspaceId, brandId, status])
}

model Job {
  id                   String    @id
  runId                String    @unique
  organizationId       String
  workspaceId          String
  brandId              String?
  status               String    @default("QUEUED")
  priority             Int       @default(50)
  requiredCapabilities Json
  idempotencyKey       String
  attemptCount         Int       @default(0)
  maxAttempts          Int       @default(3)
  nextAttemptAt        DateTime?
  currentLeaseId       String?   @unique
  terminalFingerprint  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  run          AgentRun      @relation(fields: [runId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace     @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand        Brand?        @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)
  leases       WorkerLease[] @relation("JobLeaseHistory")
  currentLease WorkerLease?  @relation("CurrentJobLease", fields: [currentLeaseId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([status, nextAttemptAt, priority, createdAt, id])
  @@index([organizationId, workspaceId, brandId])
}

model RunEvent {
  id            String   @id
  runId         String
  sequence      Int
  schemaVersion String   @default("1.0")
  eventType     String
  timestamp     DateTime
  correlationId String
  payload       Json?
  workerId      String?
  leaseId       String?
  contentHash   String
  createdAt     DateTime @default(now())

  run    AgentRun     @relation(fields: [runId], references: [id], onDelete: Restrict)
  worker Worker?      @relation(fields: [workerId], references: [id], onDelete: Restrict)
  lease  WorkerLease? @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@unique([runId, sequence])
  @@index([runId, sequence])
  @@index([workerId])
}

model Worker {
  id                String   @id
  deviceName        String
  os                String?
  runtimeAdapter    String
  runtimeVersion    String
  protocolVersion   String?
  repoMappings      Json?
  status            String   @default("ACTIVE")
  capabilityVersion Int      @default(1)
  registeredAt      DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  capabilities    WorkerCapability[]
  leases          WorkerLease[]
  events          RunEvent[]
  workspaceGrants WorkerWorkspaceGrant[]
  brandGrants     WorkerBrandGrant[]

  @@index([status, lastSeenAt])
}

model WorkerCapability {
  workerId   String
  capability String
  createdAt  DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@id([workerId, capability])
  @@index([capability])
}

model WorkerLease {
  id            String    @id
  jobId         String
  workerId      String
  generation    Int
  attemptNumber Int
  issuedAt      DateTime
  expiresAt     DateTime
  endedAt       DateTime?
  endReason     String?
  createdAt     DateTime  @default(now())

  job        Job        @relation("JobLeaseHistory", fields: [jobId], references: [id], onDelete: Restrict)
  worker     Worker     @relation(fields: [workerId], references: [id], onDelete: Restrict)
  currentJob Job?       @relation("CurrentJobLease")
  events     RunEvent[]

  @@unique([jobId, generation])
  @@index([jobId, expiresAt])
  @@index([workerId, expiresAt])
}

model WorkerWorkspaceGrant {
  id                      String    @id
  workerId                String
  organizationId          String
  workspaceId             String
  status                  String    @default("ACTIVE")
  grantedAt               DateTime
  grantedByUserIdentityId String
  revokedAt               DateTime?
  revokedByUserIdentityId String?
  updatedAt               DateTime  @updatedAt

  worker       Worker        @relation(fields: [workerId], references: [id], onDelete: Restrict)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace     @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  grantedBy    UserIdentity  @relation("WorkspaceGrantCreatedBy", fields: [grantedByUserIdentityId], references: [id], onDelete: Restrict)
  revokedBy    UserIdentity? @relation("WorkspaceGrantRevokedBy", fields: [revokedByUserIdentityId], references: [id], onDelete: Restrict)

  @@unique([workerId, workspaceId])
  @@index([workerId, status, workspaceId])
  @@index([organizationId, workspaceId, status])
}

model WorkerBrandGrant {
  id                      String    @id
  workerId                String
  organizationId          String
  workspaceId             String
  brandId                 String
  status                  String    @default("ACTIVE")
  grantedAt               DateTime
  grantedByUserIdentityId String
  revokedAt               DateTime?
  revokedByUserIdentityId String?
  updatedAt               DateTime  @updatedAt

  worker       Worker        @relation(fields: [workerId], references: [id], onDelete: Restrict)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace     @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand        Brand         @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)
  grantedBy    UserIdentity  @relation("BrandGrantCreatedBy", fields: [grantedByUserIdentityId], references: [id], onDelete: Restrict)
  revokedBy    UserIdentity? @relation("BrandGrantRevokedBy", fields: [revokedByUserIdentityId], references: [id], onDelete: Restrict)

  @@unique([workerId, brandId])
  @@index([workerId, status, brandId])
  @@index([organizationId, workspaceId, brandId, status])
}

model ApprovalRequest {
  id                        String    @id
  organizationId            String
  runId                     String?
  schemaVersion             String    @default("1.0")
  actionType                String
  targetRef                 String
  targetType                String
  workspaceId               String?
  brandId                   String?
  requiredCapability        String
  payloadHash               String
  status                    String    @default("PENDING")
  requestedByUserIdentityId String
  decidedByUserIdentityId   String?
  decidedAt                 DateTime?
  expiresAt                 DateTime
  oneTimeNonce              String?   @unique
  consumedAt                DateTime?
  consumedByUserIdentityId  String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace?    @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand        Brand?        @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)
  run          AgentRun?     @relation(fields: [runId, organizationId], references: [id, organizationId], onDelete: Restrict)
  requestedBy  UserIdentity  @relation("ApprovalRequestedBy", fields: [requestedByUserIdentityId], references: [id], onDelete: Restrict)
  decidedBy    UserIdentity? @relation("ApprovalDecidedBy", fields: [decidedByUserIdentityId], references: [id], onDelete: Restrict)
  consumedBy   UserIdentity? @relation("ApprovalConsumedBy", fields: [consumedByUserIdentityId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([runId])
}

model AuditEntry {
  id             String   @id
  organizationId String
  actorType      String
  actorId        String
  action         String
  targetType     String
  targetId       String
  correlationId  String
  metadata       Json?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, targetType, targetId, occurredAt])
  @@index([organizationId, action, occurredAt])
}
