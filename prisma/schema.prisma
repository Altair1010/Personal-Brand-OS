model Job {
  id                   String    @id
  runId                String    @unique
  organizationId       String
  workspaceId          String
  brandId              String?
  status               String    @default("QUEUED")
  priority             Int       @default(50)
  requiredCapabilities Json
  idempotencyKey       String
  attemptCount         Int       @default(0)
  maxAttempts          Int       @default(3)
  nextAttemptAt        DateTime?
  currentLeaseId       String?   @unique
  terminalFingerprint  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  run          AgentRun      @relation(fields: [runId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace     @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand        Brand?        @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)
  leases       WorkerLease[] @relation("JobLeaseHistory")
  currentLease WorkerLease?  @relation("CurrentJobLease", fields: [currentLeaseId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([status, nextAttemptAt, priority, createdAt, id])
  @@index([organizationId, workspaceId, brandId])
}

