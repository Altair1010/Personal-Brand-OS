// Personal Brand Strategy OS — Prisma schema (SQLite) — MVP LOCKED

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserIdentity {
  id        String   @id
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authIdentities AuthIdentity[]
  profile        UserProfile?
  memberships    Membership[]

  workspaceGrantsCreated   WorkerWorkspaceGrant[] @relation("WorkspaceGrantCreatedBy")
  workspaceGrantsRevoked   WorkerWorkspaceGrant[] @relation("WorkspaceGrantRevokedBy")
  brandGrantsCreated       WorkerBrandGrant[]     @relation("BrandGrantCreatedBy")
  brandGrantsRevoked       WorkerBrandGrant[]     @relation("BrandGrantRevokedBy")
  approvalsRequested       ApprovalRequest[]      @relation("ApprovalRequestedBy")
  approvalsDecided         ApprovalRequest[]      @relation("ApprovalDecidedBy")
  approvalsConsumed        ApprovalRequest[]      @relation("ApprovalConsumedBy")
  workerCredentialsCreated WorkerCredential[]     @relation("WorkerCredentialCreatedBy")
  workerCredentialsRevoked WorkerCredential[]     @relation("WorkerCredentialRevokedBy")
}

model AuthIdentity {
  id             String       @id
  userIdentityId String
  provider       String
  subject        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userIdentity   UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@index([userIdentityId])
}

model Organization {
  id         String    @id
  name       String
  status     String    @default("ACTIVE")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships           Membership[]
  workspaces            Workspace[]
  brands                Brand[]
  brandDna              BrandDNA[]
  goals                 Goal[]
  segments              AudienceSegment[]
  pillars               ContentPillar[]
  templates             ContentTemplate[]
  frameworks            Framework[]
  strategies            Strategy[]
  ideas                 ContentIdea[]
  drafts                ContentDraft[]
  posts                 Post[]
  facebookAccounts      FacebookAccount[]
  insights              PerformanceInsight[]
  promptRuns            PromptRun[]
  exports               ExportHistory[]
  metricObservations    MetricObservation[]
  agentRuns             AgentRun[]
  jobs                  Job[]
  approvals             ApprovalRequest[]
  workspaceGrants       WorkerWorkspaceGrant[]
  brandGrants           WorkerBrandGrant[]
  auditEntries          AuditEntry[]
  agentDefinitions      AgentDefinition[]
  agentRoles            AgentRole[]
  marketingCampaigns    MarketingCampaign[]
  contentDeliveries     ContentDelivery[]
  metaAdsCampaigns      MetaAdsCampaign[]
  metaAdsMetrics        MetaAdsMetricSnapshot[]
  legacyAdCampaigns     AdCampaign[]
  legacyAdMetrics       AdMetricObservation[]
  providerConnections   ProviderConnection[]
  providerOAuthAttempts ProviderOAuthAttempt[]
  envVaultEntries       EnvVaultEntry[]
  envVaultSecurity      EnvVaultSecurity[]
}

// H4.1: encrypted brand-scoped .ENV vault for Meta/Page/Ads agent configuration.
model EnvVaultEntry {
  id               String   @id
  organizationId   String
  workspaceId      String
  brandId          String
  key              String
  value            String?
  secretCiphertext String?
  isSecret         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace    @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand        Brand        @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)

  @@unique([brandId, key])
  @@index([organizationId, workspaceId, brandId])
}

model EnvVaultSecurity {
  id             String    @id
  organizationId String
  workspaceId    String
  brandId        String    @unique
  pinSalt        String
  pinHash        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace    @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand        Brand        @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)

  @@unique([brandId, workspaceId, organizationId])
  @@index([organizationId, workspaceId, brandId])
}

model Membership {
  id               String       @id
  userIdentityId   String
  organizationId   String
  organizationRole String?
  status           String       @default("ACTIVE")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  userIdentity     UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workspaceRoleBindings WorkspaceRoleBinding[]
  brandRoleBindings     BrandRoleBinding[]

  @@unique([userIdentityId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model Workspace {
  id             String       @id
  organizationId String
  name           String
  status         String       @default("ACTIVE")
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  brands                Brand[]
  roleBindings          WorkspaceRoleBinding[]
  agentRuns             AgentRun[]
  jobs                  Job[]
  workerGrants          WorkerWorkspaceGrant[]
  brandWorkerGrants     WorkerBrandGrant[]
  approvals             ApprovalRequest[]
  agentDefinitions      AgentDefinition[]
  agentRoles            AgentRole[]
  marketingCampaigns    MarketingCampaign[]
  contentDeliveries     ContentDelivery[]
  metaAdsCampaigns      MetaAdsCampaign[]
  providerConnections   ProviderConnection[]
  providerOAuthAttempts ProviderOAuthAttempt[]
  envVaultEntries       EnvVaultEntry[]
  envVaultSecurity      EnvVaultSecurity[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model WorkspaceRoleBinding {
  id             String     @id
  membershipId   String
  organizationId String
  workspaceId    String
  role           String
  status         String     @default("ACTIVE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workspace      Workspace  @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([membershipId, workspaceId])
  @@index([organizationId, workspaceId, status])
}

model Brand {
  id             String       @id
  organizationId String
  workspaceId    String
  name           String
  status         String       @default("ACTIVE")
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace      Workspace    @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  roleBindings          BrandRoleBinding[]
  brandDna              BrandDNA[]
  goals                 Goal[]
  segments              AudienceSegment[]
  pillars               ContentPillar[]
  templates             ContentTemplate[]
  frameworks            Framework[]
  strategies            Strategy[]
  ideas                 ContentIdea[]
  drafts                ContentDraft[]
  posts                 Post[]
  facebookAccounts      FacebookAccount[]
  insights              PerformanceInsight[]
  promptRuns            PromptRun[]
  exports               ExportHistory[]
  metricObservations    MetricObservation[]
  agentRuns             AgentRun[]
  jobs                  Job[]
  workerGrants          WorkerBrandGrant[]
  approvals             ApprovalRequest[]
  agentDefinitions      AgentDefinition[]
  agentRoles            AgentRole[]
  marketingCampaigns    MarketingCampaign[]
  contentDeliveries     ContentDelivery[]
  metaAdsCampaigns      MetaAdsCampaign[]
  metaAdsMetrics        MetaAdsMetricSnapshot[]
  legacyAdCampaigns     AdCampaign[]
  legacyAdMetrics       AdMetricObservation[]
  providerConnections   ProviderConnection[]
  providerOAuthAttempts ProviderOAuthAttempt[]
  envVaultEntries       EnvVaultEntry[]
  envVaultSecurity      EnvVaultSecurity?

  @@unique([id, organizationId])
  @@unique([id, workspaceId, organizationId])
  @@index([organizationId, workspaceId, status])
}

model BrandRoleBinding {
  id             String     @id
  membershipId   String
  organizationId String
  workspaceId    String
  brandId        String
  role           String
  status         String     @default("ACTIVE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand          Brand      @relation(fields: [brandId, workspaceId, organizationId], references: [id, workspaceId, organizationId], onDelete: Restrict)

  @@unique([membershipId, brandId])
  @@index([organizationId, workspaceId, brandId, status])
}

model MetricObservation {
  id             String       @id
  organizationId String
  brandId        String
  legacyPostId   String?
  metricKey      String
  valueKind      String
  numericValue   Float?
  textValue      String?
  observedAt     DateTime
  source         String
  sourceRecordId String
  dedupeKey      String
  provenance     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  brand          Brand        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  legacyPost     Post?        @relation(fields: [legacyPostId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([brandId, dedupeKey])
  @@index([organizationId, brandId, metricKey, observedAt])
  @@index([legacyPostId])
}

model AppState {
  id                 String    @id @default("singleton")
  activeGoalId       String?
  activeStrategyId   String?
  audienceApprovedAt DateTime?
  supabaseUserId     String?
  lastCloudSyncAt    DateTime?
  updatedAt          DateTime  @updatedAt
}

model UserProfile {
  id             String        @id @default(cuid())
  userIdentityId String?       @unique
  name           String
  headline       String?
  bio            String?
  avatarUrl      String?
  locale         String        @default("vi")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  identity       UserIdentity? @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)

  brandDna   BrandDNA?
  goals      Goal[]
  segments   AudienceSegment[]
  pillars    ContentPillar[]
  templates  ContentTemplate[]
  frameworks Framework[]
  strategies Strategy[]
  ideas      ContentIdea[]
  drafts     ContentDraft[]
  posts      Post[]
  insights   PerformanceInsight[]
  exports    ExportHistory[]
}

// BrandDNA đã GỘP CompanyProfile (companyName/offers/usp/region)
model BrandDNA {
  id                       String        @id @default(cuid())
  userId                   String        @unique
  organizationId           String?
  brandId                  String?       @unique
  // --- lõi cá nhân ---
  whoAmI                   String?
  field                    String?
  threeWords               Json?
  coreBeliefs              String?
  differentiation          String?
  personalStory            String?
  expertise                String?
  customerProfile          String?
  customerPain             String?
  customerMisunderstanding String?
  marketEducationGoal      String?
  // --- bối cảnh doanh nghiệp (gộp từ CompanyProfile) ---
  companyName              String?
  offers                   Json?
  usp                      String?
  region                   String?
  // --- meta ---
  sourceFiles              Json?
  aiPositioning            String?
  aiSuggestions            Json?
  version                  Int           @default(1)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  user                     UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization             Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand                    Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, brandId])
}

model Goal {
  id                String        @id @default(cuid())
  userId            String
  organizationId    String?
  brandId           String?
  name              String
  goalType          String
  timeRangeStart    DateTime?
  timeRangeEnd      DateTime?
  targetAudience    String?
  mainOffer         String?
  mainMessage       String?
  kpi               Json?
  contentRatio      Json?
  risk              String?
  successDefinition String?
  status            String        @default("active")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand             Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)

  strategies Strategy[]
  segments   AudienceSegment[]
  pillars    ContentPillar[]

  @@index([userId, status])
  @@index([organizationId, brandId])
}

// pain/falseBelief/... gộp thẳng vào persona (bỏ bảng PainPoint)
model AudienceSegment {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  brandId        String?
  goalId         String?
  name           String
  pain           String?
  falseBelief    String?
  fear           String?
  desire         String?
  language       String?
  contentAngle   String?
  cta            String?
  offer          String?
  source         String        @default("ai")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId, brandId])
}

model ContentPillar {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  brandId        String?
  goalId         String?
  name           String
  description    String?
  ratioPercent   Int           @default(0)
  objectiveMix   Json?
  status         String        @default("active")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)

  dailyPlans DailyPlan[]
  ideas      ContentIdea[]
  drafts     ContentDraft[]

  @@index([userId])
  @@index([organizationId, brandId])
}

model ContentObjective {
  id          String            @id @default(cuid())
  key         String            @unique // seo|educate|trust|conversion|story|community
  label       String
  description String?
  color       String?
  templates   ContentTemplate[]
}

// Seed cứng ở MVP (không có editor CRUD — read-only)
model ContentTemplate {
  id             String           @id @default(cuid())
  userId         String?
  organizationId String?
  brandId        String?
  name           String
  objectiveKey   String
  structure      Json
  description    String?
  exampleOutput  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           UserProfile?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?           @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  objective      ContentObjective @relation(fields: [objectiveKey], references: [key])

  @@index([objectiveKey])
  @@index([organizationId, brandId])
}

// Seed cứng ở MVP (read-only)
model Framework {
  id             String        @id @default(cuid())
  userId         String?
  organizationId String?
  brandId        String?
  name           String
  slug           String        @unique
  summary        String?
  steps          Json?
  whenToUse      String?
  example        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           UserProfile?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  strategies     Strategy[]

  @@index([organizationId, brandId])
}

model Strategy {
  id             String            @id @default(cuid())
  userId         String
  organizationId String?
  brandId        String?
  goalId         String
  name           String
  timeframeDays  Int               @default(30) // MVP: chỉ 30
  frameworkSlug  String?
  status         String            @default("active")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?            @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goal           Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  framework      Framework?        @relation(fields: [frameworkSlug], references: [slug], onDelete: SetNull)
  versions       StrategyVersion[]

  @@index([userId, goalId])
  @@index([organizationId, brandId])
}

model StrategyVersion {
  id                   String              @id @default(cuid())
  strategyId           String
  version              Int
  reason               String // BẮT BUỘC: lý do đổi hướng
  assumptions          Json?
  contentRatio         Json?
  weeklyThemes         Json?
  dailyPlanOutline     Json?
  ctaPlan              Json?
  topicMap             Json?
  recommendedTemplates Json?
  kpiToTrack           Json?
  doNotList            Json?
  structuredPlan       Json?
  approvalStatus       String              @default("DRAFT")
  approvedAt           DateTime?
  aiPromptRunId        String?
  sourceAgentRunId     String?             @unique
  editedAt             DateTime? // EM2c: đánh dấu version bị chỉnh sửa tay
  createdAt            DateTime            @default(now())
  strategy             Strategy            @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  promptRun            PromptRun?          @relation(fields: [aiPromptRunId], references: [id], onDelete: SetNull)
  weeklyPlans          WeeklyPlan[]
  posts                Post[]
  marketingCampaigns   MarketingCampaign[]

  @@unique([strategyId, version])
  @@index([strategyId, version])
}

// campaignId đã BỎ — WeeklyPlan link thẳng StrategyVersion
model WeeklyPlan {
  id                String          @id @default(cuid())
  strategyVersionId String
  weekIndex         Int
  theme             String?
  focusPillarId     String?
  objectivesMix     Json?
  notes             String?
  createdAt         DateTime        @default(now())
  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  dailyPlans        DailyPlan[]

  @@index([strategyVersionId])
}

model DailyPlan {
  id               String         @id @default(cuid())
  weeklyPlanId     String
  date             DateTime?
  dayIndex         Int
  plannedObjective String?
  plannedPillarId  String?
  suggestedTopic   String?
  suggestedCta     String?
  status           String         @default("planned")
  createdAt        DateTime       @default(now())
  weeklyPlan       WeeklyPlan     @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  plannedPillar    ContentPillar? @relation(fields: [plannedPillarId], references: [id], onDelete: SetNull)
  ideas            ContentIdea[]
  posts            Post[]

  @@index([weeklyPlanId])
}

model ContentIdea {
  id             String         @id @default(cuid())
  dailyPlanId    String?
  userId         String
  organizationId String?
  brandId        String?
  title          String
  objectiveKey   String?
  pillarId       String?
  angle          String?
  hookSeed       String?
  notes          String?
  source         String         @default("ai")
  status         String         @default("idea")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  dailyPlan      DailyPlan?     @relation(fields: [dailyPlanId], references: [id], onDelete: SetNull)
  user           UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?         @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pillar         ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  drafts         ContentDraft[]

  @@index([userId, status])
  @@index([organizationId, brandId])
}

// contentJson (TipTap) đã BỎ. Thêm analytic fields để Performance group-by được.
model ContentDraft {
  id              String         @id @default(cuid())
  contentIdeaId   String?
  contentBriefId  String?
  userId          String
  organizationId  String?
  brandId         String?
  version         Int            @default(1)
  objectiveKey    String?
  pillarId        String?
  framework       String?
  tone            String?
  length          String?
  // --- analytic dimensions (bắt buộc cho Performance/Revision) ---
  hookStyle       String? // question|contrarian|story|curiosity|pain
  ctaIntensity    String? // soft|medium|hard
  format          String? // text|image|carousel|video|reel
  topic           String?
  notes           String?
  description     String?
  // --- nội dung (plain text FB) ---
  hook            String?
  body            String?
  ending          String?
  hashtags        Json?
  imageSuggestion String?
  contentMarkdown String?
  aiPromptRunId   String?
  status          String         @default("draft")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  contentIdea     ContentIdea?   @relation(fields: [contentIdeaId], references: [id], onDelete: SetNull)
  user            UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand           Brand?         @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pillar          ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  promptRun       PromptRun?     @relation(fields: [aiPromptRunId], references: [id], onDelete: SetNull)
  post            Post?
  assets          ContentAsset[]

  @@index([organizationId, brandId])
  @@index([contentBriefId])
}

// Mirror analytic dims + attribution (strategyVersionId, dailyPlanId)
model ContentAsset {
  id             String       @id @default(cuid())
  contentDraftId String
  sourceType     String       @default("UPLOAD") // UPLOAD | GOOGLE_DRIVE
  mediaType      String       @default("FILE")   // IMAGE | VIDEO | FILE
  fileName       String?
  mimeType       String?
  localPath      String?
  sourceUrl      String?
  sortOrder      Int          @default(0)
  status         String       @default("READY")  // READY | REMOTE | RESOLVING | FAILED
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contentDraft   ContentDraft @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)

  @@index([contentDraftId, sortOrder])
  @@index([status])
}

model Post {
  id                 String              @id @default(cuid())
  contentDraftId     String              @unique
  userId             String
  organizationId     String?
  brandId            String?
  strategyVersionId  String?
  dailyPlanId        String?
  facebookAccountId  String?
  publishedAt        DateTime?
  platform           String              @default("facebook")
  permalink          String?
  finalText          String?
  // mirror để group-by nhanh (không cần join qua draft)
  objectiveKey       String?
  pillarId           String?
  hookStyle          String?
  ctaIntensity       String?
  format             String?
  topic              String?
  status             String              @default("posted")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  contentDraft       ContentDraft        @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  user               UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand              Brand?              @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  strategyVersion    StrategyVersion?    @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  dailyPlan          DailyPlan?          @relation(fields: [dailyPlanId], references: [id], onDelete: SetNull)
  facebookAccount    FacebookAccount?    @relation(fields: [facebookAccountId], references: [id])
  metrics            MetricSnapshot[]
  metricObservations MetricObservation[]
  delivery           ContentDelivery?
  metaAdsCreatives   MetaAdsCampaign[]   @relation("MetaAdsCreativePost")

  @@index([userId])
  @@index([strategyVersionId])
  @@index([facebookAccountId])
  @@index([organizationId, brandId])
}

model ProviderConnection {
  id                     String    @id
  organizationId         String
  workspaceId            String
  brandId                String
  provider               String
  status                 String    @default("DISCONNECTED")
  externalAccountId      String?
  externalAccountName    String?
  credentialCiphertext   String?
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
