DATABASE_URL="file:./dev.db"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_DEFAULT_PROVIDER="anthropic"
# KHÔNG hardcode tên model. Để trống và chọn trong Settings (AIModelConfig).
AI_DEFAULT_MODEL=""

# Piltover H2.1 provider connection fabric
PILTOVER_PUBLIC_BASE_URL="http://127.0.0.1:3015"

# Meta / Facebook / Instagram OAuth app
PILTOVER_META_APP_ID=""
PILTOVER_META_APP_SECRET=""
PILTOVER_META_GRAPH_VERSION="v23.0"

# LinkedIn OAuth app
PILTOVER_LINKEDIN_CLIENT_ID=""
PILTOVER_LINKEDIN_CLIENT_SECRET=""
PILTOVER_LINKEDIN_SCOPES="openid profile email w_member_social"

# Google OAuth app for Search Console
PILTOVER_GOOGLE_CLIENT_ID=""
PILTOVER_GOOGLE_CLIENT_SECRET=""

# Remote media safeguards used by scheduled publishing (Google Drive/shared media)
PILTOVER_REMOTE_MEDIA_MAX_BYTES="104857600"
PILTOVER_REMOTE_MEDIA_TIMEOUT_MS="30000"
